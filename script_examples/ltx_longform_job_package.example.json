    },
    {
      "id": "Clip 1B",
      "start": 6,
      "end": 12,
      "prompt": "Continue from the previous final frame; the road moves forward into stranger terrain with coherent subject identity."
    }
  ],
  "settings": {
    "output_root": "output/longform_ltx23",
